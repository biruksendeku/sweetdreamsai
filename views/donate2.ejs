<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="CONTENT-TYPE" content="text/html; charset=UTF-8">
  <title> FAQ - SweetDreams AI </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
<style>

<style>
:root {
  --black: #2c2c2c;
  --very-black: #1c1c1c;
  --white: #fff;
  --light-grey: #f4f4f4;
  --very-light-grey: rgba(200,200,200,0.5);
  --action-color: #4356ff;
  --result-holder-bkg: #444;
  --result-holder-color: #eee;
  --base-font-size: 1rem;
  --border-radius: 0.5rem;
  --theme-bkg: rgba(67, 84, 255, 0.1);
}

.darkmode {
  --black: #ffffff;
  --very-black: #f0f0f0;
  --white: #1a1a1a;
  --light-grey: #2d2d2d;
  --very-light-grey: rgba(80,80,80,0.3);
  --action-color: #6366f1;
  --result-holder-bkg: #333;
  --result-holder-color: #eee;
  --theme-bkg: rgba(255,255,255,0.15);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: #fff;
  color: #2c2c2c;
  font-family: "Quicksand", "Poppins", sans-serif;
  font-size: 1rem;
  height: 100%;
  width: 100%;
  line-height: 1.6;
  transition: background-color 0.3s ease, color 0.3s ease;
}

body.darkmode {
	background-color: #1c1c1c;
}

/* THEME TOGGLE */
.theme__choice__container {
        padding: 1.5rem;
        display: flex;
        flex-flow: row nowrap;
        align-items: center;
        justify-content: end;
        width: 100%;
        position: fixed;
        z-index: 1000;
}

.theme__choice {
  border: none;
  outline: none;
  background-color: rgba(67, 84, 255, 0.1);
  border-radius: 50%;
  padding: 0.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.theme__choice:hover {
  transform: scale(1.1);
}

.darkmode .theme__choice img {
  filter: invert(1);
}

.darkmode .menu__btn img,
.darkmode .close__btn img {
  filter: invert(1);
}

.darkmode .nav__div3 img[src*="donate.svg"] {
  filter: invert(1);
}

/* NAVIGATION */
.menu__links__section {
  display: none;
  position: absolute;
  left: 0.2rem;
  top: 0;
  z-index: 1001;
  padding: 2rem 0.8rem 2rem 0.6rem;
  backdrop-filter: blur(7px);
  border-radius: 0.8rem;
  background-color: rgba(200, 200, 200, 0.5);
}

body.darkmode .menu__links__section {
        background-color: #2c2c2c;
        border: 1px solid #eee;
}

.menu__links__section > a {
  text-decoration: underline;
  font-size: 1.15rem;
  font-weight: 500;
  color: #2c2c2c;
  display: block;
  text-align: left;
  padding: 0;
  transition: color 0.3s ease;
}

.menu__links__section > a:hover {
  color: #4356ff;
}

body.darkmode .menu__links__section > a {
	color: #eee;
}

.close__btn {
  border: none;
  outline: none;
  border-radius: 0.5rem;
  padding: 0.4rem 0.5rem;
  display: grid;
  margin: 0 auto 1rem auto;
  place-content: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
  background-color: #eee;
}

body.darkmode .close__btn {
  background-color: #1c1c1c;
}

.nav__container {
  position: sticky;
  top: 0;
  background-color: #fff;
  color: #2c2c2c;
  z-index: 1000;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  transition: background-color 0.3s ease;
}

body.darkmode .nav__container {
        background-color: #2c2c2c;
        box-shadow: 0 2px 5px rgba(210, 210, 210, 0.3);
}

.nav {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin: 0 auto;
  padding: 2.5rem 0.4rem;
  width: 85%;
  position: relative;
}

.nav__div1 > button {
  border: none;
  outline: none;
  background: transparent;
  cursor: pointer;
}

.nav__div1 > button > img {
  width: clamp(2.05rem, calc(2.05rem + 0.22vw), 2.2rem);
  height: auto;
  transition: filter 0.3s ease;
}

.nav__div2 > a {
  color: #1c1c1c;
  text-decoration: none;
  font-family: "Poppins", sans-serif;
  font-size: 1.4rem;
  font-weight: 700;
  transition: color 0.3s ease;
}

body.darkmode .nav__div2 a {
	color: #fff;
}

.nav__div3 > button { /* ☀️☀️☀️☀️☀️☀️☀️☀️Clip and boom it!!! ☀️☀️☀️☀️☀️☀️☀️☀️ */
  color: #4356ff;
}

.nav__div3 > a > img {
  width: clamp(2.05rem, calc(2.05rem + 0.22vw), 2.2rem);
  height: auto;
  transition: filter 0.3s ease;
}

.hr__footer {
  width: 85%;
  margin: 0.3rem auto;
  border: none;
  height: 1.5px;
  background-color: #222;
}

body.darkmode .hr__footer {
        background-color: #eee;
}

.footer {
  text-align: center;
  margin: 2rem 0;
  color: #2c2c2c;
  transition: color 0.3s ease;
}

.footer p {
        font-size: 0.9rem;
}

body.darkmode .footer p {
        color: #eee;
}

/* RESPONSIVE DESIGN */
@media (max-width: 768px) {
	.nav {
		padding: 1.5rem 0.4rem;
	}
	.nav__div2 a {
		font-size: 1.3rem;
	}
}

@media (max-width: 480px) {
	.nav {
		padding: 1rem 0.4rem;
	}
}

</style>
</head>
<body>

  <div class="nav__container">
    <section class="menu__links__section" id="menu__links__section">
      <button class="close__btn" id="close__btn" alt="Close">
        <img src="/icons/close.svg" />
      </button>

      <a href="/" hreflang="en" class="menu__home">&bull; Home </a><br>
      <a href="/ideas" hreflang="en" class="menu__ideas">&bull; Story Ideas </a><br>
      <a href="/tips" hreflang="en" class="menu__tips">&bull; Tips and Tricks </a><br>
      <a href="/updates" hreflang="en" class="menu__updates">&bull; Updates </a><br>
      <a href="/faq" hreflang="en" class="menu__faq">&bull; FAQ </a>
    </section>
    <nav class="nav">
      <div class="nav__divs nav__div1">
        <button id="menu__btn" class="menu__btn">
          <img src="/icons/menu.svg" alt="Menu Icon" />
        </button>
      </div>

      <div class="nav__divs nav__div2">
        <a href="/"> SweetDreams AI </a>
      </div>

      <div class="nav__divs nav__div3">
        <a href="/donate">
          <img src="/icons/donate.svg" alt="Package Donating Hand" />
        </a>
      </div>
    </nav>
  </div>

  <!-- THEME LOGIC -->
    <div class="theme__choice__container">
        <button id="theme__choice" class="theme__choice">
                <img id="light__theme" style="display: none;" width="40px" height="auto" src="/icons/sun.svg" alt="☀️" />
                <img id="dark__theme" width="40px" height="auto" src="/icons/moon.svg" alt="🌙" />
        </button>
    </div>

<!-- THE REAL CONTENT HERE -->

    <hr class="hr__footer">
      <footer class="footer">
        <p>&copy; All Rights Reserved. <br>
          DevYayu - 2025
        </p>
      </footer>
    
<script defer>
        // Menu functionality
        const menuBtn = document.getElementById("menu__btn");
        const closeBtn = document.getElementById("close__btn");
        const menuLinksSection = document.getElementById("menu__links__section");
    
        let menuTimeout;
    
        menuBtn.addEventListener("click", () => {
            clearTimeout(menuTimeout);
            menuLinksSection.style.display = "inline";
        });
    
        closeBtn.addEventListener("click", () => {
            menuLinksSection.style.display = "none";
        });
    
        menuLinksSection.addEventListener("mouseleave", () => {
            menuTimeout = setTimeout(() => {
                menuLinksSection.style.display = "none";
            }, 300);
        });
    
        menuLinksSection.addEventListener("mouseenter", () => {
            clearTimeout(menuTimeout);
        });
    
        document.addEventListener('click', (e) => {
            if (!menuLinksSection.contains(e.target) && !menuBtn.contains(e.target)) {
                menuLinksSection.style.display = "none";
            }
        });
        // THEME MANIPULATION LOGIC
            const themeBtn = document.getElementById("theme__choice");
            const lightMode = document.getElementById("light__theme");
            const darkMode = document.getElementById("dark__theme");
        
            // Check current theme from localStorage
            const savedTheme = localStorage.getItem("darkmode");
            const isDarkMode = savedTheme === "active";
        
            // Apply initial theme
            function applyTheme() {
                if (isDarkMode) {
                    document.body.classList.add("darkmode");
                    lightMode.style.display = "block";
                    darkMode.style.display = "none";
                } else {
                    document.body.classList.remove("darkmode");
                    lightMode.style.display = "none";
                    darkMode.style.display = "block";
                }
            }
        
            // Apply theme on page load
            applyTheme();
        
            // Event listener on the parent button
            themeBtn.addEventListener("click", () => {
                const isCurrentlyDark = document.body.classList.contains("darkmode");
        
                if (isCurrentlyDark) {
                    // Switch to light mode
                    document.body.classList.remove("darkmode");
                    localStorage.setItem("darkmode", "inactive");
                    lightMode.style.display = "none";
                    darkMode.style.display = "block";
                } else {
                    // Switch to dark mode
                    document.body.classList.add("darkmode");
                    localStorage.setItem("darkmode", "active");
                    lightMode.style.display = "block";
                    darkMode.style.display = "none";
                }
            });
</script>
</body>
</html>
