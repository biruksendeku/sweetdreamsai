<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="CONTENT-TYPE" content="text/html; charset=UTF-8">
  <title> Story Time &bull; SweetDreams AI </title>
  <link rel="stylesheet" href="/css/story.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
</head>
<body>

  <div class="nav__container">
    <section class="menu__links__section" id="menu__links__section">
      <button class="close__btn" id="close__btn">
        <img src="/icons/close.svg" alt="X" />
      </button>

      <a href="/">&bull; Home </a>
      <!--<a href="/ideas">&bull; Ideas&nbsp;/Inspirations </a>-->
      <a href="/tips">&bull; Tips and Tricks </a>
      <a href="/updates">&bull; Updates </a>
      <a href="/faq">&bull; FAQ </a>
    </section>
    <nav class="nav">
      <div class="nav__divs nav__div1">
        <button id="menu__btn" class="menu__btn">
          <img src="/icons/menu.svg" alt="Menu" />
        </button>
      </div>

      <div class="nav__divs nav__div2">
        <a href="/"> SweetDreams AI </a>
      </div>

      <div class="nav__divs nav__div3">
        <a href="/donate">
          <img src="/icons/donate.svg" alt="Donate" />
        </a>
      </div>
    </nav>
  </div>

  <!-- THEME LOGIC -->
    <div class="theme__choice__container">
        <button id="theme__choice" class="theme__choice">
                <img id="light__theme" style="display: none;" width="40px" height="auto" src="/icons/sun.svg" alt="☀️" />
                <img id="dark__theme" width="40px" height="auto" src="/icons/moon.svg" alt="🌙" />
        </button>
        </div>

<div class="container">
    <div class="story-card">
        <!--<h3 class="story-title" id="storyTitle">
            <% if(prompt) { %>
                    <span>"</span><%- prompt %><span>"</span>
            <% } else { %>
                    Enjoy your sweet story :)
            <% } %>
        </h3>-->

        <div class="story-content" id="storyContent">
            <!-- Offline message placeholder -->
            <p class="offline__msg__manager"></p>
            <h3 class="story-title" id="story-title">
            	<% if(prompt) { %>
            		<%- prompt %>
            	<% } else { %>
            		Enjoy your sweet story :)
            	<% } %>
            </h3>

            <!-- the REAL STORY PART -->
            <% if (story && story.text) { %>
                <p class="result__paragraph">
                    <%= story.text %>
                </p>
                
                <!-- Cache the story in localStorage -->
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        <% if (story && story.text && story.timestamp) { %>
                            try {
                                // Safer way to store the story
                                const storyData = {
                                    text: `<%= story.text.replace(/'/g, "\\'").replace(/\n/g, '\\n') %>`,
                                    timestamp: <%= story.timestamp %>
                                };
                                
                                const lastSaved = JSON.parse(localStorage.getItem('lastStory'));
                                if (!lastSaved || storyData.timestamp > lastSaved.timestamp) {
                                    localStorage.setItem('lastStory', JSON.stringify(storyData));
                                    console.log('Story cached successfully!');
                                }
                            } catch (error) {
                                console.error('Error saving to localStorage:', error);
                            }
                        <% } %>
                        
                        // Check offline status immediately
                        checkOfflineStatus();
                    });
                    
                    function checkOfflineStatus() {
                        if (!navigator.onLine) {
                            loadCachedStory();
                        }
                    }
                    
                    function loadCachedStory() {
                        try {
                            const cached = JSON.parse(localStorage.getItem('lastStory'));
                            const resultHolder = document.getElementById('storyContent');
                            const offlineMsg = document.querySelector('.offline__msg__manager');

                            if (cached && cached.text) {
                                offlineMsg.innerHTML = `<p class="offline__notice"> Offline Mode: Showing last story</p>`;
                                // Only replace if we don't already have fresh content
                                if (!<%= (story && story.text) ? 'true' : 'false' %>) {
                                    resultHolder.innerHTML = `<p class="result__paragraph">${cached.text}</p>`;
                                }
                            } else if (!<%= (story && story.text) ? 'true' : 'false' %>) {
                                resultHolder.innerHTML = `<p class="error__message" style="color: red;">
                                    You're offline and no stories are cached yet.
                                </p>`;
                            }
                        } catch (error) {
                            console.error('Error loading cached story:', error);
                        }
                    }
                    
                    // Listen for online/offline events
                    window.addEventListener('online', checkOfflineStatus);
                    window.addEventListener('offline', checkOfflineStatus);
                </script>
            <% } %>

            <% if (error && (!story || !story.text)) { %>
                <p class="error__message" style="color: red; text-align: center;">
                    Error: <%= error %>
                </p>
                
                <!-- Try to load cached story even when there's an error -->
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        // If there's an error, try to show cached story
                        const cached = JSON.parse(localStorage.getItem('lastStory'));
                        if (cached && cached.text) {
                            document.querySelector('.offline__msg__manager').innerHTML = 
                                `<p class="offline__notice"> Showing last cached story due to error</p>`;
                            document.getElementById('storyContent').innerHTML += 
                                `<p class="result__paragraph">${cached.text}</p>`;
                        }
                    });
                </script>
            <% } %>
        </div>

        <div class="action-buttons">
            <a href="/" class="btn btn-primary">
                <img src="/icons/revolvingStars.svg" width="25px" height="auto" alt="✨"> Create Another Story
            </a>
            <button class="btn btn-secondary" id="printBtn">
                <img src="/icons/print.svg" width="25px" height="auto" alt="📄"> Print This Story
            </button>
        </div>
    </div>
</div>

<!-- Print-specific styles -->
<style>
    @media print {
        .action-buttons, .offline__msg__manager, .nav {
            display: none !important;
        }
        
        .story-card {
            border: none !important;
            box-shadow: none !important;
        }
        
        body {
            background: white !important;
            color: black !important;
        }
    }
    
    /* Make print button work better on mobile */
    #printBtn {
        cursor: pointer;
    }
</style>

<script>
    // Enhanced print functionality for mobile
    document.addEventListener('DOMContentLoaded', function() {
        const printBtn = document.getElementById('printBtn');
        
        printBtn.addEventListener('click', function() {
            // Check if we're on mobile
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            
            if (isMobile) {
                // Mobile devices might need special handling
                if (window.chrome) {
                    // Chrome mobile
                    window.print();
                } else if (navigator.userAgent.match(/iPhone|iPad|iPod/i)) {
                    // iOS - show alert with instructions
                    alert('On iOS: Tap Share → Scroll down → Tap Print');
                } else {
                    // Android/other mobile
                    window.print();
                }
            } else {
                // Desktop - normal print
                window.print();
            }
        });
        
        // Also add keyboard shortcut for print (Ctrl+P)
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
                e.preventDefault();
                window.print();
            }
        });
    });
</script>

<hr class="hr__footer">
<div class="footer__div">
      <footer class="footer">
        <p>&copy; All Rights Reserved. <br>
          SweetDreams AI  &bull;  <%= new Date().getFullYear() %>
        </p>
      </footer>
</div>
<script defer src="/js/story.js"></script>
</body>
</html>
