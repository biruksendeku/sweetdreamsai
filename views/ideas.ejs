<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="CONTENT-TYPE" content="text/html; charset=UTF-8">
  <title> Inspiration and Ideas &bull; SweetDreams AI </title>
  <link rel="stylesheet" href="/css/ideas.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="nav__container">
    <section class="menu__links__section" id="menu__links__section">
      <button class="close__btn" id="close__btn">
        <img src="/icons/close.svg" alt="Close"/>
      </button>

      <a href="/">&bull; Home </a>
      <a href="/ideas">&bull; Ideas&nbsp;/Inspirations </a>
      <a href="/tips">&bull; Tips and Tricks </a>
      <a href="/updates">&bull; Updates </a>
      <a href="/faq">&bull; FAQ </a>
    </section>
    <nav class="nav">
      <div class="nav__divs nav__div1">
        <button id="menu__btn" class="menu__btn">
          <img src="/icons/menu.svg" alt="Menu" />
        </button>
      </div>

      <div class="nav__divs nav__div2">
        <a href="/"> SweetDreams AI </a>
      </div>

      <div class="nav__divs nav__div3">
        <a href="/donate">
          <img src="/icons/donate.svg" alt="Donate" />
        </a>
      </div>
    </nav>

  </div>

        <!-- THEME LOGIC -->
            <div class="theme__choice__container">
                <button id="theme__choice" class="theme__choice">
                  <img id="light__theme" style="display: none;" width="40px" height="auto" src="/icons/sun.svg" alt="☀️" />
                  <img id="dark__theme" width="40px" height="auto" src="/icons/moon.svg" alt="🌙" />
                </button>
            </div>

    <div class="container">
        <div class="header">
            <h1>Spark Your Imagination</h1>
            <p>Need inspiration? Browse our collection of story ideas perfect for creating magical bedtime adventures.</p>
        </div>

        <div class="category-section">
            <h2 class="category-title">Magical Adventures</h2>
            <div class="ideas-grid">
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Moonlit Garden</h3>
                    <p>A hidden garden that only blooms at midnight, where flowers whisper secrets to those who listen carefully.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Star Collector</h3>
                    <p>A child who collects fallen stars and uses their light to brighten the dreams of sleeping animals.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Cloud Weaver</h3>
                    <p>An old spider who spins clouds into beautiful shapes and teaches young spiders about weather patterns.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
            </div>
        </div>

        <div class="category-section">
            <h2 class="category-title">Animal Friends</h2>
            <div class="ideas-grid">
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Shy Dragon</h3>
                    <p>A tiny dragon who's afraid of fire and learns that being different is what makes you special.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>Owl's Night School</h3>
                    <p>A wise owl who teaches nocturnal animals how to read using moonlight and fireflies.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Lost Penguin</h3>
                    <p>A penguin who discovers a warm ocean current and makes friends with tropical fish.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
            </div>
        </div>

        <div class="category-section">
            <h2 class="category-title">Dreamy Fantasy</h2>
            <div class="ideas-grid">
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Dream Catcher's Apprentice</h3>
                    <p>A young girl learning to weave dream catchers that show happy memories instead of blocking bad dreams.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The River of Time</h3>
                    <p>A magical river where you can see yesterday's memories floating by like leaves on the water.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
                <div class="idea-card" onclick="copyToClipboard(this)">
                    <h3>The Quiet Giant</h3>
                    <p>A giant who walks so softly that mushrooms grow in his footsteps, creating paths through the forest.</p>
                    <button class="copy-btn">Copy Prompt</button>
                </div>
            </div>
        </div>

        <div class="quick-tips">
            <h2>Pro Tips for Amazing Stories</h2>
            <ul>
                <li><strong>Be specific:</strong> Instead of "a dragon," try "a tiny dragon who loves baking cookies"</li>
                <li><strong>Add emotions:</strong> Characters with feelings create more engaging stories</li>
                <li><strong>Include senses:</strong> Describe sounds, smells, and textures to bring stories to life</li>
                <li><strong>Keep it positive:</strong> Sweet dreams come from gentle, uplifting adventures</li>
                <li><strong>Mix and match:</strong> Combine ideas from different categories for unique stories</li>
            </ul>
        </div>
    </div>

  <hr class="hr__footer">
  <footer class="footer">
    &copy;All Right Reserved. <br>
    SweetDreams AI  &bull;  <%= new Date().getFullYear() %>
  </footer>

</body>
<script src="/js/ideas.js"></script>
</html>
